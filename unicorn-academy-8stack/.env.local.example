# .env.local — Copy to project root, NEVER commit to git

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── Cloudflare R2 ──
R2_ACCOUNT_ID=your_cf_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=unicorn-smart-ai
R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev

# ── Cloudflare Workers ──
WORKERS_URL=https://unicorn-smart-ai-proxy.YOUR_SUBDOMAIN.workers.dev

# ── Referral HMAC Secret (generate: openssl rand -base64 32) ──
REFERRAL_HMAC_SECRET=your_32_byte_secret_base64

# ── Resend ──
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=noreply@unicornsmartai.cloud

# ── LINE Notify ──
LINE_NOTIFY_TOKEN=your_line_notify_token

# ── App ──
NEXT_PUBLIC_APP_URL=https://unicornsmartai.cloud
