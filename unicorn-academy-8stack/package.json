{
  "name": "unicorn-academy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "workers:dev": "wrangler dev --config workers/wrangler.toml",
    "workers:deploy": "wrangler deploy --config workers/wrangler.toml",
    "pages:build": "opennextjs-cloudflare build && cp .open-next/worker.js .open-next/assets/_worker.js && cp -r .open-next/cloudflare .open-next/assets/ && cp -r .open-next/middleware .open-next/assets/ && cp -r .open-next/.build .open-next/assets/ && cp -r .open-next/server-functions .open-next/assets/",
    "pages:preview": "opennextjs-cloudflare preview",
    "pages:deploy": "npm run pages:build && wrangler pages deploy .open-next/assets"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3",
    "@aws-sdk/s3-request-presigner": "^3",
    "@supabase/ssr": "^0",
    "@supabase/supabase-js": "^2",
    "lucide-react": "^0.562.0",
    "next": "15",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^4"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10",
    "eslint": "^9",
    "eslint-config-next": "latest",
    "postcss": "^8",
    "tailwindcss": "^3",
    "typescript": "^5",
    "wrangler": "^3"
  }
}
